{
  "_说明": "复制本文件为 config/credentials.json 并填入自己的凭据。credentials.json 已 gitignore，不会被提交。",
  "confluence": {
    "baseUrl": "https://confluence.<公司域名>.com",
    "username": "<你的域账号>",
    "password": "<你的密码>",
    "apiPath": "/rest/api"
  },
  "feishu": {
    "wikiBaseUrl": "https://<租户>.feishu.cn/wiki",
    "note": "飞书取数走 lark-cli，首次使用需 OAuth 授权，见 tool-usage skill"
  },
  "yapi": {
    "baseUrl": "https://yapi.<公司域名>.com",
    "note": "接口文档平台，只读取数"
  },
  "lanhu": {
    "note": "蓝湖设计稿目前靠截图 + OCR，无 API 凭据"
  },
  "zentao": {
    "baseUrl": "https://zentao.<公司域名>.com",
    "username": "<你的禅道账号>",
    "password": "<你的禅道密码>"
  },
  "git": {
    "ignore": [
      "config/credentials.json",
      "*.env",
      ".env*"
    ]
  }
}
