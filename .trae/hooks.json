{
  "hooks": {
    "Stop": [
      {
        "name": "auto-check-lessons-learned",
        "enabled": true,
        "command": "bash .trae/hooks/on-stop-check-lessons.sh"
      }
    ],
    "PostToolUse": [
      {
        "name": "check-feishu-auth",
        "enabled": false,
        "matcher": "WebFetch",
        "command": "bash .trae/hooks/post-tool-feishu-auth.sh"
      },
      {
        "name": "error-detect-lessons",
        "enabled": true,
        "matcher": "RunCommand",
        "command": "bash .trae/hooks/post-tool-error-detect.sh"
      }
    ],
    "SessionStart": [
      {
        "name": "load-project-context",
        "enabled": true,
        "command": "bash .trae/hooks/session-start.sh"
      }
    ]
  }
}
